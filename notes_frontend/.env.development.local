# Development-only overrides to support preview environments accessed via non-localhost hosts.
# This prevents the "Invalid Host header" error when tunneling/proxying the dev server.
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Bind to all interfaces so preview systems can reach the dev server.
HOST=0.0.0.0

# Optional: ensure the client connects back correctly in proxied environments.
# Uncomment and set if your preview requires a specific socket port.
# WDS_SOCKET_PORT=3000
